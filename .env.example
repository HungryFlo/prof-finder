# Prof-Finder Configuration

# LLM API (OpenAI-compatible or Anthropic Messages API)
# Provider: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Legacy env names (optional fallback)
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# Database Configuration
DATABASE_PATH=./data/prof_finder.db

# Crawler Configuration
REQUEST_DELAY=3
SCHOLARLY_PROXY=

# Default User (optional, for CLI convenience)
DEFAULT_USER=default

# Admin Account Configuration
# Default: root / root123 (will be prompted to change on first login)
ADMIN_USERNAME=root
ADMIN_PASSWORD=root123

# JWT Configuration (recommended for dev servers you keep running; random per restart if unset)
# JWT_SECRET_KEY=your_stable_secret_here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
