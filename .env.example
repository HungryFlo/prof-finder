# Prof-Finder Configuration

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Database Configuration
DATABASE_PATH=./data/prof_finder.db

# Crawler Configuration
REQUEST_DELAY=3
SCHOLARLY_PROXY=

# Default User (optional, for CLI convenience)
DEFAULT_USER=default

# Admin Account Configuration
# Default: root / root123 (will be prompted to change on first login)
ADMIN_USERNAME=root
ADMIN_PASSWORD=root123

# JWT Configuration (optional, auto-generated if not set)
# JWT_SECRET_KEY=your_secret_key_here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
